# El Padel — Raspberry Pi backend environment
# Copy to .env next to docker-compose.pi.yml and chmod 600.
# Generate secrets on the Pi; never commit the real .env.
#
#   cp .env.pi.example .env
#   chmod 600 .env
#   openssl rand -base64 32   # use for POSTGRES_PASSWORD, JWT_SECRET, bootstrap token

COMPOSE_PROJECT_NAME=elpadel_pi

# Pin the backend image by git SHA (never "latest").
IMAGE_TAG=replace-with-git-sha
# Optional display version for GET /api/meta/version
APP_VERSION=

# Relocatable Postgres data directory. Default is on the SD card; point at a
# USB SSD mount later (see RASPBERRY_PI.md) without changing compose.
PG_DATA_DIR=/srv/elpadel/pgdata

# Host / container timezone for logs. Domain civil times still use Asia/Tbilisi.
TZ=UTC

# PostgreSQL (internal Docker network only — never publish the port).
# Do NOT use the local-dev password elpadel:elpadel.
POSTGRES_USER=elpadel_app
POSTGRES_PASSWORD=replace-with-openssl-rand-base64-32
POSTGRES_DB=elpadel_prod

# Must match POSTGRES_* above. Host is the compose service name `postgres`.
DATABASE_URL=postgresql://elpadel_app:replace-with-openssl-rand-base64-32@postgres:5432/elpadel_prod?schema=public

# Public URLs the browser sees (HTTPS). FRONTEND_URL is the CORS/CSRF allow-list
# (comma-separated). BACKEND_URL must be the Pi API hostname behind Cloudflare Tunnel.
# The API hostname MUST share the same registrable domain as the frontend so
# session cookies stay same-site (e.g. https://elpadell.com + https://api-pi.elpadell.com).
FRONTEND_URL=https://elpadell.com,https://www.elpadell.com
BACKEND_URL=https://api-pi.elpadell.com
# Optional. Auto-derived when FRONTEND_URL and BACKEND_URL share a parent.
# Do not set COOKIE_DOMAIN= to an empty value — omit the line instead.
# COOKIE_DOMAIN=.elpadell.com

# Auth. JWT_SECRET >= 32 chars, not a placeholder.
JWT_SECRET=replace-with-openssl-rand-base64-48
# ADMIN_EMAILS=admin@example.com
# One-time only. Remove from .env and recreate api after the first admin exists.
# Production refuses to start if this remains set once an admin row exists.
FIRST_ADMIN_BOOTSTRAP_TOKEN=replace-with-openssl-rand-base64-32

# Email via Resend. REQUIRED when NODE_ENV=production.
RESEND_API_KEY=re_replace_with_resend_key
RESEND_FROM_EMAIL=El Padel <onboarding@resend.dev>

# Google OAuth. Omit these lines (or leave unset) to disable Gmail login.
# If set, GOOGLE_REDIRECT_URI must be a full https URL matching Google Cloud Console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://api-pi.elpadell.com/api/auth/google/callback

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → configure → Docker).
# Public hostname <PI_API_HOSTNAME> should route HTTP to http://api:4000
# Enable WebSockets on the Cloudflare zone (default on modern zones).
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
