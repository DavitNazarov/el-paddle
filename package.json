{
  "name": "el-paddle",
  "version": "1.2.1",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c magenta,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "start:frontend": "npm run start --workspace frontend",
    "start:backend": "npm run start --workspace backend",
    "lint": "npm run lint --workspace frontend && npm run lint --workspace backend",
    "audit": "npm audit --audit-level=high",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:migrate": "npm run prisma:migrate --workspace backend",
    "prisma:studio": "npm run prisma:studio --workspace backend",
    "db:seed": "npm run db:seed --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.3"
  }
}
