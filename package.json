{
  "name": "el-paddle",
  "version": "1.5.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c magenta,cyan \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "start:frontend": "npm run start --workspace frontend",
    "start:backend": "npm run start --workspace backend",
    "lint": "npm run lint --workspace frontend && npm run lint --workspace backend",
    "test": "npm run test --workspace backend && npm run test --workspace frontend",
    "test:integration": "npm run test:integration --workspace backend",
    "audit": "npm audit --audit-level=high",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:migrate": "npm run prisma:migrate --workspace backend",
    "prisma:studio": "npm run prisma:studio --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "readiness:check": "sh scripts/production-readiness-check.sh"
  },
  "devDependencies": {
    "concurrently": "^9.2.3"
  },
  "overrides": {
    "postcss": "^8.5.22",
    "sharp": "^0.35.3",
    "find-my-way": "^9.7.0",
    "undici": "^7.29.0",
    "fast-uri": "^3.1.5",
    "brace-expansion@1": "^1.1.18",
    "brace-expansion@5": "^5.0.9"
  }
}
