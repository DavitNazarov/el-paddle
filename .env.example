# Docker Compose project
COMPOSE_PROJECT_NAME=el_paddle

# Published host ports for host-level Nginx reverse proxy.
# These are bound to 127.0.0.1 only by docker-compose.yml.
FRONTEND_PUBLIC_PORT=3000
BACKEND_PUBLIC_PORT=4000
FRONTEND_INTERNAL_PORT=3000
BACKEND_INTERNAL_PORT=4000

# PostgreSQL container
POSTGRES_USER=elpadel
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=elpadel

# Prisma/PostgreSQL connection used by the backend container.
# Use the compose service name `postgres` as the host when using the bundled DB container.
DATABASE_URL=postgresql://elpadel:replace-with-a-strong-database-password@postgres:5432/elpadel?schema=public

# Public URLs. Replace with your real domains.
FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

# Auth/admin
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=admin@example.com

# Email via Resend. Leave RESEND_API_KEY empty only if you intentionally want dev console email logs.
RESEND_API_KEY=
RESEND_FROM_EMAIL="El Padel <onboarding@resend.dev>"

# Google OAuth / Gmail login. Leave empty to disable Gmail login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/auth/google/callback
