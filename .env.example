# Docker Compose project
COMPOSE_PROJECT_NAME=el_paddle

# Published host ports for host-level Nginx reverse proxy.
# These are bound to 127.0.0.1 only by docker-compose.yml.
FRONTEND_PUBLIC_PORT=3000
BACKEND_PUBLIC_PORT=4000
FRONTEND_INTERNAL_PORT=3000
BACKEND_INTERNAL_PORT=4000

# PostgreSQL container
POSTGRES_USER=elpadel_app
POSTGRES_PASSWORD=generate-a-unique-secret
POSTGRES_DB=elpadel_prod

# Prisma/PostgreSQL connection used by the backend container.
# Use the compose service name `postgres` as the host when using the bundled DB container.
DATABASE_URL=postgresql://elpadel_app:generate-a-unique-secret@postgres:5432/elpadel_prod?schema=public

# Public URLs. Replace with your real domains.
# Comma-separated FRONTEND_URL entries are all allowed by CORS/CSRF; the first is used for redirects.
FRONTEND_URL=https://elpadell.com,https://www.elpadell.com
BACKEND_URL=https://api.elpadell.com
NEXT_PUBLIC_API_URL=https://api.elpadell.com
# Optional. Shared auth cookie Domain for split site/API hosts.
# Auto-derived as .elpadell.com when FRONTEND_URL and BACKEND_URL share a parent.
# COOKIE_DOMAIN=.elpadell.com

# Public legal/business identity. Required before launch.
NEXT_PUBLIC_LEGAL_ENTITY_NAME="El Padel Tournament Tbilisi"
NEXT_PUBLIC_LEGAL_ENTITY_FORM="LLC"
NEXT_PUBLIC_LEGAL_ENTITY_ID=
NEXT_PUBLIC_LEGAL_ADDRESS="Tbilisi, Georgia"
NEXT_PUBLIC_LEGAL_EMAIL=register@elpadel.club
NEXT_PUBLIC_LEGAL_PHONE=

# Auth/admin
# JWT_SECRET must be >= 32 chars and not a placeholder. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=admin@example.com
# One-time only. Remove from .env and recreate the backend container after the first admin exists.
FIRST_ADMIN_BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-secret

# Email via Resend. REQUIRED in production (NODE_ENV=production) — console fallback is disabled there.
RESEND_API_KEY=
RESEND_FROM_EMAIL="El Padel <onboarding@resend.dev>"

# Transactional outbox. Keep true in production so the API process emits realtime Socket.IO topics.
RUN_OUTBOX_IN_API=true

# Google OAuth / Gmail login. Leave empty to disable Gmail login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.elpadell.com/api/auth/google/callback
